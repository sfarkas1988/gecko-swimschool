#!/bin/sh
# Prüft vor dem Hochladen, ob sich die Website bauen lässt.
# Eigener Ausgabeordner, damit eine laufende Vorschau (npm run dev) nicht gestört wird.
# Direkter node-Aufruf: das Git von GitHub Desktop hat kein bash, npm/npx laufen dort nicht.
# Meldungen ohne Umlaute, weil GitHub Desktop sie sonst falsch darstellt.
. "$(dirname "$0")/find-node.sh"

echo "Die Website wird testweise gebaut (dauert ca. eine Minute) ..."

if ! NEXT_DIST_DIR=.next-check node node_modules/next/dist/bin/next build; then
  echo ""
  echo "=================================================================="
  echo " Der Build ist fehlgeschlagen - das Hochladen wurde gestoppt."
  echo " Es ist nichts kaputt gegangen. Bitte Claude bitten:"
  echo " \"Der Build ist fehlgeschlagen, bitte beheben.\""
  echo "=================================================================="
  exit 1
fi
